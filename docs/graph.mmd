%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
	__start__([<p>__start__</p>]):::first
	retrieve(retrieve)
	triage(triage)
	generate(generate)
	refuse(refuse)
	verify(verify)
	revise(revise)
	safe_fail(safe_fail)
	__end__([<p>__end__</p>]):::last
	__start__ --> retrieve;
	generate --> verify;
	refuse --> verify;
	retrieve --> triage;
	revise --> generate;
	safe_fail --> __end__;
	triage -.-> generate;
	triage -.-> refuse;
	verify -. &nbsp;accept&nbsp; .-> __end__;
	verify -.-> revise;
	verify -.-> safe_fail;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
